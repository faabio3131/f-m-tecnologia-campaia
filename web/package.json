{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:session": "playwright test --config=playwright.session.config.ts",
    "contracts:generate": "openapi-typescript ../contracts/bff-openapi.yaml -o src/contracts/bff-openapi.generated.ts",
    "contracts:check": "node scripts/check-contract-drift.mjs",
    "boundary:check": "node scripts/check-security-boundaries.mjs",
    "check": "npm run lint && npm run typecheck && npm run contracts:check && npm run boundary:check && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
