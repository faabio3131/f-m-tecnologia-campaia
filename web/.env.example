# CampaIA Web — variáveis de ambiente (Etapa 2). Copie para .env.local e preencha
# valores reais. NUNCA commite .env.local nem qualquer segredo real neste arquivo.

# Origem real do BFF (Starlette), usada SOMENTE no servidor (Next.js) para o proxy
# same-origin em next.config.ts — nunca exposta ao navegador via NEXT_PUBLIC_*.
CAMPAIA_BFF_ORIGIN=http://127.0.0.1:8000

# "test" habilita o seletor de identidade do harness de E2E na tela de login —
# NUNCA definir em preview/staging/produção. Ausente/qualquer outro valor = modo real.
NEXT_PUBLIC_CAMPAIA_IDENTITY_MODE=

# Configuração PÚBLICA do Google Identity Platform para o navegador. Estes valores
# identificam o cliente Web/projeto e não são segredo de tenant nem credencial privada.
# Restrinja a API key/origens no Google Cloud e nunca coloque service account/private key aqui.
NEXT_PUBLIC_GOOGLE_IDENTITY_CLIENT_ID=
NEXT_PUBLIC_IDENTITY_PLATFORM_PUBLIC_API=
